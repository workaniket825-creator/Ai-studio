# Copy to .env (same folder) and adjust. `docker compose --env-file .env up --build`.
# Or set values in your shell/CI. All have safe defaults; none are required to boot.

RUNTIME=live                         # live (LiteLLM) | adk (needs google-adk in the image)
CORS_ORIGINS=http://localhost:8080   # where the UI is served from

# Postgres (provisioned + persisted; used by MLflow-optional and future RAG/pgvector)
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studio

# Optional env fallback for models (normally configured in the UI → Model Endpoints)
MODEL_PROVIDER=
AZURE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# --- Jupyter MCP (set via the MCP Servers UI → written here → `docker compose up -d jupyter-mcp`) ---
JUPYTER_URL=http://host.docker.internal:8888
JUPYTER_TOKEN=
